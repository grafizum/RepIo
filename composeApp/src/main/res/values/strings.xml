    <string name="select_body_parts_desc">Select all to train or use preset:</string>
    <string name="goal_strength_desc">Focus: High intensity, low reps (1–5) for maximum neurological adaptation and strength.</string>
    <string name="goal_bodybuilding_desc">Focus: Moderate reps (8–12) for metabolic stress and maximum hypertrophy.</string>
    <string name="goal_calisthenics_desc">Focus: Higher reps (12–20) to build muscular endurance and body mastery.</string>
    <string name="goal_functional_desc">Focus: Dynamic movements with 10–15 reps to improve athletic longevity and core strength.</string>
    <string name="insight_volume_title">Training Volume</string>
    <string name="insight_volume_hard_desc">High volume pushing your recovery limits. Ideal for maximizing hypertrophy if recovery is managed well.</string>
    <string name="insight_volume_medium_desc">Optimal volume for consistent muscle growth and sustainable progress.</string>
    <string name="insight_volume_easy_desc">Lower volume focused on technique maintenance and active recovery.</string>
    <string name="insight_frequency_title">Training Frequency</string>
    <string name="insight_frequency_desc">Distributing muscle groups twice a week often yields superior results compared to once-a-week splits.</string>
    <string name="insight_goal_title">Goal Alignment</string>
    <string name="insight_rest_title">Rest Intervals</string>
    <string name="insight_goal_bodybuilding_desc">Hypertrophy-focused training using moderate rep ranges to maximize metabolic stress.</string>
    <string name="insight_rest_goal_bodybuilding_desc">Rest periods of 60–90 seconds are recommended to balance fatigue and volume.</string>
    <string name="insight_goal_strength_desc">Strength-focused training with high intensity to improve motor unit recruitment.</string>
    <string name="insight_rest_goal_strength_desc">Longer rest (3–5 mins) is optimal for recovery of the ATP-CP system.</string>
