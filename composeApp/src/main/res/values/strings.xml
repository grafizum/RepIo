    <!-- FAQ RPE & RIR -->
    <string name="rpe_rir_faq">RPE &amp; RIR Guide</string>
    <string name="rpe_rir_explanation">Quickly understand training intensity</string>
    <string name="what_is_rpe">What is RPE?</string>
    <string name="rpe_desc">Rate of Perceived Exertion (1–10 scale). It measures how hard a set felt.</string>
    <string name="rpe_10">RPE 10: Maximum effort. No more reps left in the tank.</string>
    <string name="rpe_9">RPE 9: Very hard. 1 rep left in the tank.</string>
    <string name="rpe_8">RPE 8: Hard. 2 reps left in the tank.</string>
    <string name="what_is_rir">What is RIR?</string>
    <string name="rir_desc">Reps In Reserve. How many reps you \"left in the tank\" before failure.</string>
    <string name="rir_0">0 RIR = RPE 10 (Absolute failure)</string>
    <string name="rir_1">1 RIR = RPE 9</string>
    <string name="rir_2">2 RIR = RPE 8</string>
