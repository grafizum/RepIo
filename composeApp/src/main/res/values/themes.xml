<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.MyApplication" parent="Theme.AppCompat.DayNight.NoActionBar" />

    <!-- Post-splash themes for seamless transition -->
    <style name="Theme.App.PostSplash.Flame" parent="Theme.MyApplication">
        <item name="android:windowBackground">@color/bg_flame</item>
    </style>

    <style name="Theme.App.PostSplash.Beige" parent="Theme.MyApplication">
        <item name="android:windowBackground">@color/bg_beige</item>
    </style>

    <style name="Theme.App.PostSplash.Purple" parent="Theme.MyApplication">
