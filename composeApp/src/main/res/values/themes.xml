<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.MyApplication" parent="Theme.AppCompat.DayNight.NoActionBar" />

    <!-- Base splash screen theme -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="postSplashScreenTheme">@style/Theme.MyApplication</item>
        <item name="windowSplashScreenBackground">@color/bg_flame</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_main_logo_foreground_orange</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/bg_flame</item>
    </style>

