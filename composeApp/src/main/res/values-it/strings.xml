    <string name="what_is_rpe">Cos\'è l\'RPE?</string>
    <string name="rpe_desc">Grado di sforzo percepito (scala 1–10). Misura quanto è stata dura una serie.</string>
    <string name="rpe_10">RPE 10: Sforzo massimo. Nessun\'altra ripetizione possibile.</string>
    <string name="rpe_9">RPE 9: Molto duro. 1 ripetizione rimasta.</string>
    <string name="rpe_8">RPE 8: Duro. 2 ripetizioni rimaste.</string>
    <string name="what_is_rir">Cos\'è l\'RIR?</string>
    <string name="rir_desc">Ripetizioni in riserva. Quante ripetizioni \"hai lasciato nel serbatoio\" prima del cedimento.</string>
    <string name="rir_0">0 RIR = RPE 10 (Cedimento assoluto)</string>
    <string name="rir_1">1 RIR = RPE 9</string>
    <string name="rir_2">2 RIR = RPE 8</string>
