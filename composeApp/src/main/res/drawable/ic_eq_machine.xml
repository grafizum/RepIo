<?xml version="1.0" encoding="utf-8"?>
<!-- Gym machine: weight-stack tower with dividers, seat on a post, lever arm. Replaces the robot-arm icon. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- stack tower outline -->
    <path
        android:strokeColor="#FF000000"
        android:strokeWidth="1.8"
        android:pathData="M14.5,3.5 H19 V20.5 H14.5 Z" />
    <!-- weight stack dividers -->
    <path
        android:strokeColor="#FF000000"
        android:strokeWidth="1.2"
        android:pathData="M14.5,7 H19 M14.5,10.5 H19 M14.5,14 H19" />
    <!-- lever arm from the tower pivot towards the seat -->
    <path
        android:strokeColor="#FF000000"
        android:strokeWidth="1.8"
        android:strokeLineCap="round"
        android:pathData="M14.5,8.5 L9.5,11.5" />
    <!-- pivot -->
    <path
        android:fillColor="#FF000000"
        android:pathData="M14.5,8.5 m-1.2,0 a1.2,1.2 0 1 0 2.4,0 a1.2,1.2 0 1 0 -2.4,0" />
    <!-- seat -->
    <path
        android:fillColor="#FF000000"
        android:pathData="M5.5,13.2 H11 V15.8 H5.5 Z" />
    <!-- seat post -->
    <path
        android:strokeColor="#FF000000"
        android:strokeWidth="1.8"
        android:strokeLineCap="round"
        android:pathData="M8.2,15.8 V20.5" />
</vector>
