<?xml version="1.0" encoding="utf-8"?>
<!--
  Monochrome (themed icon) layer of the RepIo adaptive launcher icon.

  This is the launcher icon's logo only — no background square — drawn on the
  same 108dp canvas as ic_launcher_fg_* and at exactly the same position and
  size, so the themed icon lines up with the regular one.

  Previously the adaptive icons pointed <monochrome> at ic_notification, which
  is authored for a 24dp notification slot; used as a 108dp foreground it came
  out roughly a third of the intended size.

  Keep the path data in sync with ic_notification.xml (same artwork, different
  canvas size).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Dumbbell: two plates (tall sleeve + wider collar) joined by the bar. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M38.25,33 h7.5 v22.5 h-7.5 z M34,37 h4.25 v14 h-4.25 z M34,42.25 h39 v3.75 h-39 z M61,33 h7.75 v22.5 h-7.75 z M68.75,37 h4.25 v14 h-4.25 z" />

    <!-- Heartbeat: flat line, spike up, spike down past the line, flat line. -->
    <path
        android:pathData="M34.7,67.1 L43.75,67.1 L46,62.2 L50,73.8 L54,67.1 L72.3,67.1"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.4"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
