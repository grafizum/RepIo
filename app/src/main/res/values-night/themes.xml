<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark Mode overrides for Splash Screen -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground_orange</item>
        <item name="windowSplashScreenBackground">@color/splash_bg_dark</item>
        <item name="postSplashScreenTheme">@style/Theme.MyApplication</item>
    </style>

    <style name="Theme.App.Starting.Beige" parent="Theme.App.Starting">
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground_orange</item>
    </style>
</resources>
