<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.MyApplication" parent="Theme.AppCompat.DayNight.NoActionBar" />

    <!-- Base splash screen theme (Shared Defaults) -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="postSplashScreenTheme">@style/Theme.MyApplication</item>
    </style>

    <!-- Orange / Dark Theme Splash (STATIC BLACK) -->
    <style name="Theme.App.Starting.Orange" parent="Theme.App.Starting">
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_main_logo_foreground</item>
        <item name="windowSplashScreenBackground">@color/splash_bg_black</item>
    </style>

    <!-- Beige / Light Theme Splash (STATIC WHITE) -->
    <style name="Theme.App.Starting.Beige" parent="Theme.App.Starting">
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_main_logo_foreground_beige</item>
        <item name="windowSplashScreenBackground">@color/splash_bg_light</item>
    </style>
</resources>
