<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.MyApplication" parent="Theme.AppCompat.DayNight.NoActionBar" />

    <!-- Base splash screen theme (Shared Defaults) - DEFAULT TO LIGHT -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="postSplashScreenTheme">@style/Theme.MyApplication</item>
        <item name="windowSplashScreenBackground">@color/splash_bg_light</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground_beige</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/splash_bg_light</item>
    </style>

    <!-- Compatibility Alias for Orange -->
    <style name="Theme.App.Starting.Orange" parent="Theme.App.Starting" />

    <!-- Flame / Dark Theme Splash -->
    <style name="Theme.App.Starting.Flame" parent="Theme.App.Starting">
